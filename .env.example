# ───────────────────────────── Base de données ─────────────────────────────
# SQLite par défaut (aucun service à installer) : fichier relatif au projet.
DATABASE_URL=file:./data/appelpro.sqlite
# PostgreSQL : décommentez et adaptez, le schéma est créé automatiquement.
# DATABASE_URL=postgresql://appelpro:motdepasse@localhost:5432/appelpro
# DATABASE_SSL=1   # pour un Postgres hébergé exigeant TLS

# ───────────────────────────── Authentification ────────────────────────────
# Secret de signature des jetons (32 caractères minimum, obligatoire en prod).
# Générer : openssl rand -base64 48
AUTH_SECRET=
# Durée de vie d'un jeton, en secondes (8 h par défaut)
AUTH_TOKEN_TTL=28800
# 0 pour fermer les inscriptions (compte créés uniquement via AUTH_SEED_*)
AUTH_ALLOW_REGISTER=1
# Premier compte administrateur, créé au démarrage si la base est vide
AUTH_SEED_EMAIL=admin@appelpro.io
AUTH_SEED_PASSWORD=changez-moi
AUTH_SEED_NAME=Administrateur

# ───────────────────────────── Offres (veille) ─────────────────────────────
# API publique de veille, appelée par le navigateur (aperçu public)…
NEXT_PUBLIC_API_URL=http://192.168.88.12:8001/api/public
# …et par le serveur Next pour le catalogue complet (mêmes routes)
API_UPSTREAM_URL=http://192.168.88.12:8001/api/public
API_UPSTREAM_TIMEOUT=5000
# auto | local | api  — repli sur le jeu local quand l'API est injoignable
NEXT_PUBLIC_DATA_MODE=auto
